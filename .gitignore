*.cpuprofile

# Repository-root allowlist. The repository root holds only maintained project
# documents and configuration. Everything else that agents put there is session
# output: reports, plans, receipts, evidence dumps, scratch scripts, and the
# workspace directories created by Harness/Agent/IDE tools (`.workbuddy*`,
# `.claude/`, `.codex/`, ...). A new formal root document or root dot entry
# must be added to these exceptions and to docs/maintenance/git-workflow.md
# before it can be tracked.
/*.md
!/AGENTS.md
!/ARCHITECTURE_AND_DEVELOPMENT.md
!/CONTRIBUTING.md
!/CONTRIBUTING.zh-CN.md
!/DEVELOPMENT_ROADMAP.md
!/DEVELOPMENT_ROADMAP.zh-CN.md
!/DOCUMENTATION_INDEX.md
!/MAINTENANCE.md
!/PROJECT_STATUS.md
!/README.md
!/README.zh-CN.md
!/SECURITY.md
!/THIRD_PARTY_NOTICES.md
/.*
!/.gitattributes
!/.gitignore
!/.npmrc
!/.github/
!/.husky/
!/.myharness/

# Environment
.env

# Editor / IDE local state
.vscode/
.zed/
.idea/
*.swp
*.swo
*~

# Coding-agent local workspace state (memory, receipts, scratch output). These
# directories belong to the agent tool that created them and never to MyHarness
# source. The list is not closed: root-level dot directories are already covered
# by the repository-root allowlist above, but a new nested agent directory must
# be added here and to the matching path rules in scripts/release-audit.mjs
# before it can leak into a commit.
.claude/
.codex/
.cursor/
.continue/
.opencode/
.gemini/
.aider*
.windsurf/
.codeium/
.junie/
.kiro/
.roo/
.qwen/
.crush/
.agent/
.agents/
.pi_config/
.workbuddy*/
/_receipts/
/_tickets/
/outputs/

# Package specific
.npm/
coverage/
.nyc_output/
tui-debug.log
compaction-results/
syntax.jsonl
out.jsonl
myharness-*.html
out.html
packages/coding-agent/binaries/
# Optional, user-installed Windows language-server modules. The source tree
# carries only the manifest, launcher, and redistribution notices.
packages/coding-agent/code-intelligence/runtime/
packages/coding-agent/code-intelligence/.staging/
packages/coding-agent/code-intelligence/.downloads/
packages/coding-agent/code-intelligence/data/
/data/
packages/coding-agent/data/
/profiles-node/
/test-artifacts/
*.dmp
*.sqlite
*.sqlite3
*.db
tools/dev-launcher/target/
todo.md
plans/
.myharness/hf-sessions/
.myharness/hf-sessions-backup/
