{
  "schemaVersion": 1,
  "project": "myharness",
  "releaseVersion": "0.4.0",
  "myharnessVersionRange": ">=0.80.10 <0.81.0",
  "platform": {
    "os": "Windows",
    "architecture": "x64",
    "defaultMode": "lightweight",
    "optionalInstall": "per-language",
    "offlineAtRuntime": true,
    "globalInstallation": "none"
  },
  "sourceRuntime": {
    "lightweightIndex": "packages/coding-agent/src/symbols/index",
    "languageServers": "not stored in the source checkout",
    "releaseManifest": "runtime-manifest.json"
  },
  "entries": [
