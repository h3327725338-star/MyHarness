{
	"name": "@myharness/agent-sqlite-node",
	"version": "0.80.10",
	"description": "Node sqlite storage backend for @myharness/agent-core sessions",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"README.md"
	],
	"scripts": {
		"clean": "node -e \"import('node:fs/promises').then(fs=>fs.rm('dist',{recursive:true,force:true}))\"",
		"build": "tsgo -p tsconfig.build.json && node ./scripts/prepare-dist.mjs copy-sqlite-migrations",
		"prepublishOnly": "npm run clean && npm run build"
	},
	"author": "Earendil Works",
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/h3327725338-star/MyHarness.git",
		"directory": "packages/storage/sqlite-node"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"dependencies": {
		"@myharness/ai": "^0.80.10",
		"@myharness/agent-core": "^0.80.10"
	}
}
